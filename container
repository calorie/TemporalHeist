#!/bin/sh
# Host-side orchestration only. All project processes run in Compose services.
set -eu
agent_id=${1:?Usage: sh container AGENT_RUN_ID COMPOSE_ARGUMENTS...}
shift
case "$agent_id" in
  ''|*[!a-z0-9-]*) echo 'AGENT_RUN_ID must contain only a-z, 0-9, and hyphens' >&2; exit 2 ;;
esac
if [ -d /Applications/Docker.app/Contents/Resources/bin ]; then
  PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
  export PATH
fi
TH_AGENT_ID="$agent_id"
export TH_AGENT_ID
release_metadata() {
  TH_RELEASE_SOURCE=${TH_RELEASE_SOURCE:-https://github.com/calorie/TemporalHeist}
  TH_RELEASE_REVISION=${TH_RELEASE_REVISION:-$(git rev-parse HEAD)}
  short_revision=$(printf '%s' "$TH_RELEASE_REVISION" | cut -c1-12)
  TH_RELEASE_VERSION=${TH_RELEASE_VERSION:-0.6.0-rc.1-$short_revision}
  TH_RELEASE_IMAGE_TAG=${TH_RELEASE_IMAGE_TAG:-$agent_id-$TH_RELEASE_VERSION}
  case "$TH_RELEASE_IMAGE_TAG" in
    ''|*[!A-Za-z0-9_.-]*) echo 'TH_RELEASE_IMAGE_TAG must contain only A-Z, a-z, 0-9, dot, underscore, and hyphen' >&2; exit 2 ;;
  esac
  if [ -n "${SOURCE_DATE_EPOCH:-}" ] && [ -z "${TH_RELEASE_CREATED:-}" ]; then
    echo 'TH_RELEASE_CREATED (RFC3339) is required when SOURCE_DATE_EPOCH is overridden' >&2
    exit 2
  fi
  SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(git show -s --format=%ct "$TH_RELEASE_REVISION")}
  TH_RELEASE_CREATED=${TH_RELEASE_CREATED:-$(git show -s --format=%cI "$TH_RELEASE_REVISION")}
  export TH_RELEASE_SOURCE TH_RELEASE_REVISION TH_RELEASE_VERSION TH_RELEASE_IMAGE_TAG TH_RELEASE_CREATED SOURCE_DATE_EPOCH
}
require_clean_release_context() {
  dirty=$(git status --porcelain --untracked-files=all -- . ':(exclude).release')
  if [ -n "$dirty" ]; then
    echo 'release build context must be clean' >&2
    printf '%s\n' "$dirty" >&2
    exit 2
  fi
}
BUILDX_CONFIG=${BUILDX_CONFIG:-/tmp/th-buildx-$agent_id}
export BUILDX_CONFIG
mkdir -p "$BUILDX_CONFIG"

compose() {
  docker compose --project-name "th-$agent_id" --file compose.yaml "$@"
}

command=${1:-}
case "$command" in
  bootstrap)
    compose build dev
    compose pull --policy missing relay
    compose run --rm dev npm ci
    ;;
  verify)
    compose build dev
    compose run --rm dev npm ci
    compose run --rm dev sh containers/verify.sh
    ;;
  acceptance)
    release_metadata
    compose pull --policy missing relay
    compose build authority web browser
    compose up -d --force-recreate --wait relay authority web
    compose --profile test run --rm browser
    ;;
  visual)
    release_metadata
    compose pull --policy missing relay
    compose build authority web visual-browser-a visual-browser-b
    compose --profile visual up -d relay authority web visual-browser-a visual-browser-b
    for service in visual-browser-a visual-browser-b; do
      compose exec -T "$service" sh -c '
        attempts=0
        until wget -qO- http://127.0.0.1:6080/vnc.html 2>/dev/null | grep -q noVNC; do
          attempts=$((attempts + 1))
          test "$attempts" -lt 30
          sleep 1
        done
      '
      compose exec -T "$service" node containers/visual-display-check.mjs
    done
    compose exec -T visual-browser-a node containers/visual-browser-check.mjs
    compose exec -T visual-browser-b node containers/visual-browser-check.mjs
    published_a=$(compose port visual-browser-a 6080)
    published_b=$(compose port visual-browser-b 6080)
    echo "Player A noVNC: http://$published_a/vnc.html?autoconnect=1&resize=scale"
    echo "Player B noVNC: http://$published_b/vnc.html?autoconnect=1&resize=scale"
    echo "Cleanup: sh container $agent_id down --volumes --remove-orphans"
    ;;
  release-build)
    require_clean_release_context
    release_metadata
    compose build authority web
    ;;
  release-inspect)
    require_clean_release_context
    release_metadata
    manifest=${TH_RELEASE_MANIFEST:-.release/$agent_id/manifest.json}
    mkdir -p "$(dirname "$manifest")"
    authority_image="temporal-heist-authority:$TH_RELEASE_IMAGE_TAG"
    web_image="temporal-heist-web:$TH_RELEASE_IMAGE_TAG"
    sh containers/assert-release-images.sh
    {
      printf '{"schemaVersion":1,"sourceSha":"%s","version":"%s","imageTag":"%s","created":"%s","images":[' \
        "$TH_RELEASE_REVISION" "$TH_RELEASE_VERSION" "$TH_RELEASE_IMAGE_TAG" "$TH_RELEASE_CREATED"
      docker image inspect "$authority_image" --format '{"role":"authority","reference":"'"$authority_image"'","id":{{json .Id}},"repoDigests":{{json .RepoDigests}},"size":{{json .Size}},"labels":{{json .Config.Labels}}}'
      printf ','
      docker image inspect "$web_image" --format '{"role":"web","reference":"'"$web_image"'","id":{{json .Id}},"repoDigests":{{json .RepoDigests}},"size":{{json .Size}},"labels":{{json .Config.Labels}}}'
      printf ']}\n'
    } >"$manifest"
    printf '%s\n' "$manifest"
    ;;
  release-smoke)
    require_clean_release_context
    release_metadata
    compose pull --policy missing relay
    compose build authority web
    compose up -d relay authority web
    compose exec -T web wget -qO- http://127.0.0.1:5173/healthz | grep -qx ok
    if compose exec -T web wget -qO- http://127.0.0.1:5173/healthz/ >/dev/null 2>&1; then
      echo '/healthz/ must not use the SPA fallback' >&2
      exit 1
    fi
    test "$(compose exec -T web id -u)" = 101
    test "$(compose exec -T authority id -u)" = 65532
    for service in authority web; do
      container_id=$(compose ps -q "$service")
      test "$(docker inspect "$container_id" --format '{{.HostConfig.ReadonlyRootfs}}')" = true
      docker inspect "$container_id" --format '{{json .HostConfig.CapDrop}}' | grep -q 'ALL'
      docker inspect "$container_id" --format '{{json .HostConfig.SecurityOpt}}' | grep -q 'no-new-privileges'
    done
    sh containers/assert-release-images.sh
    ;;
  runtime-reliability)
    release_metadata
    compose pull --policy missing relay
    compose build authority web
    cleanup_runtime_reliability() {
      compose down --remove-orphans >/dev/null
    }
    trap cleanup_runtime_reliability EXIT INT TERM
    compose up -d --force-recreate --wait relay authority web
    authority_id=$(compose ps -q authority)
    restart_count_before=$(docker inspect "$authority_id" --format '{{.RestartCount}}')
    started_before=$(docker inspect "$authority_id" --format '{{.State.StartedAt}}')
    epoch_before=$(compose logs authority | sed -n 's/.*"room_epoch":"\([^"]*\)".*/\1/p' | head -1)
    starts_before=$(compose logs authority | grep -c '"event":"authority_started"')
    test -n "$epoch_before"
    compose stop relay
    compose exec -T authority th-authority --healthcheck=live
    attempts=0
    while compose exec -T authority th-authority --healthcheck=ready 2>/dev/null; do
      attempts=$((attempts + 1)); test "$attempts" -lt 30; sleep 1
    done
    compose start relay
    attempts=0
    until compose exec -T authority th-authority --healthcheck=ready; do
      attempts=$((attempts + 1)); test "$attempts" -lt 30; sleep 1
    done
    test "$(compose ps -q authority)" = "$authority_id"
    test "$(docker inspect "$authority_id" --format '{{.RestartCount}}')" = "$restart_count_before"
    test "$(docker inspect "$authority_id" --format '{{.State.StartedAt}}')" = "$started_before"
    test "$(compose logs authority | grep -c '"event":"authority_started"')" = "$starts_before"
    epoch_after_relay=$(compose logs authority | sed -n 's/.*"room_epoch":"\([^"]*\)".*/\1/p' | tail -1)
    test "$epoch_after_relay" = "$epoch_before"
    compose restart authority
    attempts=0
    until compose exec -T authority th-authority --healthcheck=ready; do
      attempts=$((attempts + 1)); test "$attempts" -lt 30; sleep 1
    done
    epoch_after_restart=$(compose logs authority | sed -n 's/.*"room_epoch":"\([^"]*\)".*/\1/p' | tail -1)
    test -n "$epoch_after_restart"
    test "$epoch_after_restart" != "$epoch_before"
    compose stop --timeout 5 authority
    compose logs authority | grep -q '"event":"shutdown_complete"'
    printf '{"relayEpoch":"%s","restartEpoch":"%s","readiness":"ready-unready-ready","shutdown":"clean"}\n' "$epoch_before" "$epoch_after_restart"
    trap - EXIT INT TERM
    cleanup_runtime_reliability
    ;;
  runtime-browser-recovery)
    release_metadata
    compose build authority web browser
    compose up -d --wait relay authority web
    compose run --rm dev sh -c 'rm -f /artifacts/relay-stopped /artifacts/relay-started /artifacts/authority-restarted'
    browser_id=$(compose --profile test run -d browser node tests/runtime-recovery.mjs)
    wait_log() {
      pattern=$1; attempts=0
      until docker logs "$browser_id" 2>&1 | grep -q "$pattern"; do
        attempts=$((attempts + 1)); test "$attempts" -lt 90; sleep 1
      done
    }
    wait_log 'baseline-ready'
    compose stop relay
    docker exec "$browser_id" touch /artifacts/relay-stopped
    wait_log 'relay-outage-observed'
    compose start relay
    docker exec "$browser_id" touch /artifacts/relay-started
    wait_log 'relay-recovered'
    compose restart authority
    docker exec "$browser_id" touch /artifacts/authority-restarted
    wait_log 'authority-recovered'
    test "$(docker wait "$browser_id")" = 0
    docker logs "$browser_id"
    docker rm "$browser_id" >/dev/null
    ;;
  release-soak)
    require_clean_release_context
    release_metadata
    evidence_dir=.release/$agent_id
    mkdir -p "$evidence_dir"
    compose build dev
    compose run --rm dev npm ci
    compose run --rm dev cargo test -p th-authority \
      tests::six_hour_virtual_soak_keeps_resources_and_payloads_bounded -- --exact --nocapture \
      >"$evidence_dir/soak.log" 2>&1
    compose run --rm dev node tests/renderer-gpu.mjs \
      >"$evidence_dir/webgpu.log" 2>&1
    cat "$evidence_dir/soak.log"
    cat "$evidence_dir/webgpu.log"
    ;;
  release-evidence)
    require_clean_release_context
    release_metadata
    evidence_dir=.release/$agent_id
    mkdir -p "$evidence_dir"
    finalize_release_evidence() {
      compose config --format json >"$evidence_dir/compose-config.json" 2>/dev/null || true
      compose ps --all --format json >"$evidence_dir/compose-resources.json" 2>/dev/null || true
      compose logs --no-color --no-log-prefix authority >"$evidence_dir/authority-lifecycle.jsonl" 2>/dev/null || true
      mkdir -p "$evidence_dir/artifacts"
      compose --profile test run --rm --no-deps \
        -v "$(pwd)/$evidence_dir/artifacts:/evidence" browser \
        sh -c 'cp -R /artifacts/. /evidence/ 2>/dev/null || true' >/dev/null 2>&1 || true
    }
    trap finalize_release_evidence EXIT HUP INT TERM
    sh "$0" "$agent_id" release-build
    TH_RELEASE_MANIFEST="$evidence_dir/manifest.json" sh "$0" "$agent_id" release-inspect
    sh "$0" "$agent_id" release-smoke
    sh "$0" "$agent_id" release-soak
    sh "$0" "$agent_id" acceptance
    sh "$0" "$agent_id" runtime-reliability >"$evidence_dir/runtime-reliability.log" 2>&1
    sh "$0" "$agent_id" runtime-browser-recovery >"$evidence_dir/runtime-browser-recovery.log" 2>&1
    finalize_release_evidence
    TH_EVIDENCE_DIR="/workspace/$evidence_dir" compose run --rm dev node containers/evidence-index.mjs
    trap - EXIT HUP INT TERM
    printf '%s\n' "$evidence_dir/index.json"
    ;;
  two-stack-isolation)
    require_clean_release_context
    evidence_dir=${2:-.release/$agent_id/isolation}
    worktree_root=${TMPDIR:-/tmp}/temporal-heist-$agent_id-isolation
    worktree_a=$worktree_root/a
    worktree_b=$worktree_root/b
    cleanup_worktrees() {
      git worktree remove --force "$worktree_a" >/dev/null 2>&1 || true
      git worktree remove --force "$worktree_b" >/dev/null 2>&1 || true
    }
    trap cleanup_worktrees EXIT HUP INT TERM
    mkdir -p "$worktree_root"
    git worktree add --detach "$worktree_a" HEAD
    git worktree add --detach "$worktree_b" HEAD
    sh containers/verify-two-stack-isolation.sh \
      "$worktree_a" "$agent_id-a" "$worktree_b" "$agent_id-b" "$evidence_dir"
    ;;
  export-evidence)
    evidence_dir=.release/$agent_id/artifacts
    mkdir -p "$evidence_dir"
    compose --profile test run --rm --no-deps \
      -v "$(pwd)/$evidence_dir:/evidence" browser \
      sh -c 'cp -R /artifacts/. /evidence/ 2>/dev/null || true'
    ;;
  down)
    shift
    compose --profile test --profile visual down "$@"
    ;;
  *) exec docker compose --project-name "th-$agent_id" --file compose.yaml "$@" ;;
esac
